*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.json text eol=lf
*.py text eol=lf
*.kra filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.ora filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.cs text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.meta text eol=lf
*.wav filter=lfs diff=lfs merge=lfs -text
* text=auto eol=lf
# These exact bytes are sealed in the v2 local capture provenance. Do not let
# checkout line-ending conversion invalidate the accepted capture build/input.
tools/ymir_character_capture/* -text whitespace=trailing-space,space-before-tab,cr-at-eol
data/character/routes/* -text whitespace=trailing-space,space-before-tab,cr-at-eol
data/event/routes/* -text whitespace=trailing-space,space-before-tab,cr-at-eol
tools/verify_character_capture.py -text whitespace=trailing-space,space-before-tab,cr-at-eol
tests/test_character_capture.py -text whitespace=trailing-space,space-before-tab,cr-at-eol
character-reference-lock.json -text whitespace=trailing-space,space-before-tab,cr-at-eol
# Keep content-addressed generation/approval records byte-identical on checkout.
art/enhanced25d-landing/v1/**/*.json -text
art/enhanced25d-landing/v1/**/*.prompt.txt -text
# The Unity baseline is content-addressed by the generated runtime manifest.
unity-remake/SourceContracts/*.json -text whitespace=trailing-space,space-before-tab,cr-at-eol
# Unity serializes empty YAML scalars with a trailing space.
unity-remake/**/*.meta whitespace=-blank-at-eol
unity-remake/**/*.asset whitespace=-blank-at-eol
*.ttf filter=lfs diff=lfs merge=lfs -text
"unity-remake/Assets/TextMesh Pro/Resources/Fonts & Materials/*.asset" filter=lfs diff=lfs merge=lfs -text
"unity-remake/Assets/TextMesh Pro/**" whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
art/unity/**/*.json -text whitespace=trailing-space,space-before-tab,cr-at-eol
art/unity/**/*.html -text whitespace=trailing-space,space-before-tab,cr-at-eol

*.otf filter=lfs diff=lfs merge=lfs -text
art/unity/player-refined-v1-delivery/review.html filter=lfs diff=lfs merge=lfs -text
art/unity/player-refined-v2/review.html filter=lfs diff=lfs merge=lfs -text
