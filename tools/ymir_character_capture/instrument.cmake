observe_replace_once("                m_VDP1CtlState.drawing = false;" "                m_VDP1CtlState.drawing = false;\n                AOCharacterObserve(\"vdp1_end_requested\", m_scheduler, m_state, m_VDP1CtlState.drawing);")
observe_replace_once("        m_renderer->VDP2RenderLine(m_state.regs2.VCNT);" "        AOCharacterObserve(\"vdp2_render_line\", m_scheduler, m_state, m_VDP1CtlState.drawing, m_state.regs2.VCNT);\n        m_renderer->VDP2RenderLine(m_state.regs2.VCNT);")
