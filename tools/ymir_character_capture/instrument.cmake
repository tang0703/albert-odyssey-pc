# Derive one observed translation unit; never modify the pinned checkout.
set(_original "${YMIR_SOURCE_DIR}/libs/ymir-core/src/ymir/hw/vdp/vdp.cpp")
file(SHA256 "${_original}" _sha)
if(NOT _sha STREQUAL "ab9cfce4c31f81e80874579779d8eefa976113a34a159036600fc4d9118e1202")
  message(FATAL_ERROR "Unsupported upstream vdp.cpp; instrumentation anchors are pinned")
endif()
file(READ "${_original}" _code)
function(observe_replace_once before after)
  string(FIND "${_code}" "${before}" _pos)
  if(_pos EQUAL -1)
    message(FATAL_ERROR "Missing observation anchor: ${before}")
  endif()
  string(LENGTH "${before}" _len)
  math(EXPR _end "${_pos}+${_len}")
  string(SUBSTRING "${_code}" ${_end} -1 _rest)
  string(FIND "${_rest}" "${before}" _duplicate)
  if(NOT _duplicate EQUAL -1)
    message(FATAL_ERROR "Ambiguous observation anchor: ${before}")
  endif()
  string(REPLACE "${before}" "${after}" _code "${_code}")
  set(_code "${_code}" PARENT_SCOPE)
endfunction()
observe_replace_once("#include <ymir/hw/vdp/vdp.hpp>" "#include <ymir/hw/vdp/vdp.hpp>\n#include \"observer_bridge.hpp\"")
