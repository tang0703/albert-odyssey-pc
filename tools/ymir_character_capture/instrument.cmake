file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/generated")
set(_observed "${CMAKE_CURRENT_BINARY_DIR}/generated/vdp_character.cpp")
file(WRITE "${_observed}" "${_code}")
get_target_property(_sources ymir-core SOURCES)
set(_replacement_count 0)
set(_observed_sources "")
foreach(_item IN LISTS _sources)
  if(_item MATCHES "(^|/)src/ymir/hw/vdp/vdp\\.cpp$")
    list(APPEND _observed_sources "${_observed}")
    math(EXPR _replacement_count "${_replacement_count}+1")
  else()
    list(APPEND _observed_sources "${_item}")
  endif()
endforeach()
if(NOT _replacement_count EQUAL 1)
  message(FATAL_ERROR "Expected exactly one VDP translation unit")
endif()
set_property(TARGET ymir-core PROPERTY SOURCES "${_observed_sources}")
target_include_directories(ymir-core PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}")
